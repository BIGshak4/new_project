  "prep-remove-all-ascii-spaces": {
    "contract": {
      "he": "ממשו remove_spaces(text). מחקו רק U+0020 מכל המחרוזת, ושמרו שאר תווים וסדרם. טאב, שורה חדשה ורווח בלתי שביר נשמרים; ריק מחזיר ריק.",
      "en": "Implement remove_spaces(text): remove only U+0020 everywhere, retaining all other characters and order. Preserve tabs, newlines and nonbreaking spaces. Empty returns empty."
    },
    "languages": {
      "python": {
        "kind": "function",
        "entry": "remove_spaces",
