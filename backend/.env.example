# Copy this file to backend/.env and fill it in. backend/.env is git-ignored. Never commit secrets.

# --- Supabase Postgres -------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler".
# Paste it as shown (postgresql://...); the backend switches it to the asyncpg driver itself.
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=

# --- Supabase Auth (login verification) -------------------------------------------
# Project Settings -> API -> Project URL. Login tokens are verified against the project's
# public signing keys at SUPABASE_URL/auth/v1/.well-known/jwks.json. This is not a secret.
SUPABASE_URL=https://djpwvqpsqbkvprlncjjg.supabase.co
# Only for projects still on the legacy shared-secret (HS256) JWT setup. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# During the pilot only e-mails in Harel's jr_members table may use the practice API.
REQUIRE_PILOT_MEMBERSHIP=true

# --- API -----------------------------------------------------------------------------
# development | staging | production. Production refuses to start when something is missing.
ENV=development
# Browser origins allowed to call the API directly, comma-separated (the Netlify sites and localhost).
ALLOWED_ORIGINS=http://localhost:3000
# Attempts one user may start per UTC day.
DAILY_ATTEMPT_LIMIT=30

# --- LLM ---------------------------------------------------------------------------
# manual    = every model call is written to backend/workdir/manual_llm/ and waits for a reply file.
#             No key needed. This is how the engine runs before an API key exists.
# anthropic = the real Claude API.
LLM_PROVIDER=manual

# Anthropic Console -> API keys. Set a monthly spend limit on the workspace first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Server-side fallbacks re-run a request on another model if a safety classifier declines it
# by mistake, so one false positive does not interrupt a session.
ANTHROPIC_ENABLE_FALLBACKS=true

# --- Content -----------------------------------------------------------------------
# Development only. Production serves published, parity-checked questions and nothing else.
ALLOW_IN_REVIEW_CONTENT=false

DEFAULT_LANGUAGE=en
