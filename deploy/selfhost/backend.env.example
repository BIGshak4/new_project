# Copy to backend.env ON THE SERVER, permission 600; never commit actual values.
# Compose reads this file in raw format: use unquoted values, including literal $ signs.
# Transfer the existing server configuration securely. Preserve all additional settings,
# particularly payment, model-role, rate-limit and execution-broker configuration.
ENV=production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
HEALTH_KEY=
REQUIRE_PILOT_MEMBERSHIP=true
ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://tasks.example.com
SITE_URL=https://example.com

# Preserve the currently selected real provider and its settings.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DAILY_ATTEMPT_LIMIT=30
DEFAULT_LANGUAGE=en
ALLOW_IN_REVIEW_CONTENT=true
ASSESS_UNREVIEWED_QUESTIONS=true

# Keep the existing isolated execution broker and EXACT existing signing seed.
# Learner code must never execute inside this VPS or the API container.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_URL=https://jobrun-executor-job-runer.vercel.app
CODE_EXECUTION_SIGNING_SEED=

# Preserve existing billing values if payments are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_REGULAR=
STRIPE_PRICE_PREMIUM=
REQUIRE_PAYMENT=false
BILLING_FREE_OPTION_VISIBLE=true
