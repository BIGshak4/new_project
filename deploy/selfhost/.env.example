# Public deployment settings only. Copy to .env (ignored by Git).
# Supply the FULL reviewed 40-character lowercase Git SHA; all images share this tag.
SOURCE_REVISION=
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
# Only needed with compose.tasks.yaml.
TASKS_DOMAIN=tasks.example.com
# Contact for HTTPS certificate renewal notices.
ACME_EMAIL=

# These values are PUBLIC and are embedded in the browser bundles during the build.
# Use the existing Supabase project, not a new database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
